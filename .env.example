# ─── VYOMIRA environment ────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit real secrets.

# Deployment stage: development | staging | production
# APP_ENV=production refuses test payments and the development secrets below.
APP_ENV=development

# PostgreSQL (Prisma). docker compose up -d provides this locally.
DATABASE_URL="postgresql://vyomira:vyomira@localhost:5432/vyomira?schema=public"

# Redis (rate limits + caches). Optional locally — falls back to in-memory.
REDIS_URL="redis://localhost:6379"

# Better Auth — generate with: openssl rand -base64 48
BETTER_AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Extra comma-separated origins allowed to call auth endpoints (preview deployments etc.)
TRUSTED_ORIGINS=""

# Google sign-in (optional). Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AES-256-GCM key for birth details & chart payloads — 32 random bytes, base64.
# Generate with: openssl rand -base64 32   (losing this key makes stored charts unreadable)
BIRTH_DATA_ENCRYPTION_KEY="ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE="

# Payments — PayU India (primary). OAuth client credentials from PayU Dashboard → Developers,
# plus your Merchant ID. Webhook URL: https://<host>/api/payments/webhook/payu
PAYU_CLIENT_ID=""
PAYU_CLIENT_SECRET=""
PAYU_MERCHANT_ID=""
PAYU_ENV="production"          # or "uat" for PayU's sandbox credentials

# "test" opens a clearly-labelled simulator when no provider is configured (no money moves).
# Razorpay is an alternative adapter if PayU isn't configured.
PAYMENTS_MODE="test"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Optional Stripe for non-INR currencies (also enable the "stripe" feature flag in /admin/pricing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AI provider: none | anthropic | openai-compatible
# "none" → AURA answers with the deterministic rule engine (clearly labelled).
AI_PROVIDER="none"
ANTHROPIC_API_KEY=""
# Any OpenAI-compatible Chat Completions endpoint (OpenRouter, Groq, Together, Azure, vLLM…)
OPENAI_COMPAT_API_KEY=""
OPENAI_COMPAT_BASE_URL=""
# Model ids (editable later in /admin/ai). Defaults: everyday chat claude-haiku-5-5, deep/priority claude-opus-5-5
AI_MODEL_FAST=""
AI_MODEL_DEEP=""
# Hard monthly ceiling; above it AURA falls back to the rule engine.
AI_MONTHLY_BUDGET_USD=50

# Transactional email via Resend (optional — skipped and logged when empty)
RESEND_API_KEY=""
EMAIL_FROM="VYOMIRA <hello@vyomira.app>"

# Comma-separated emails that become ADMIN on sign-up
ADMIN_EMAILS="admin@vyomira.local"

# Legal identity shown on policies and grievance pages (public — fill before launch)
NEXT_PUBLIC_LEGAL_ENTITY_NAME=""
NEXT_PUBLIC_LEGAL_ADDRESS=""
NEXT_PUBLIC_LEGAL_JURISDICTION_CITY="Mumbai"
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=""
NEXT_PUBLIC_GRIEVANCE_EMAIL=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_PRIVACY_EMAIL=""
NEXT_PUBLIC_GSTIN=""
